# Server-side only (Vercel → Settings → Environment Variables, or export locally).
# Set at least one key. With GEMINI_API_KEY set, Gemini is used by default.

# Google Gemini (live web via Google Search grounding): https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI (live web via the web_search tool): https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini

# Optional: force a provider (gemini | openai)
# LLM_PROVIDER=gemini
